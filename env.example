# One block per account. Slots don't need to be contiguous (ACCOUNT_2 and ACCOUNT_4 is fine).
# Accounts run in ascending slot order.
#
# There is NO password here on purpose: you sign in with Google yourself, once, using
#   npm run manual-login -- --email you@gmail.com
# and the saved browser session in ./sessions is reused by every run.

ACCOUNT_1_EMAIL=email@example.com
# ACCOUNT_1_LABEL=Main account

# Optional per-account browser proxy (http://, https://, socks4://, socks5://)
# ACCOUNT_1_PROXY_URL=http://127.0.0.1:8080
# ACCOUNT_1_PROXY_USERNAME=
# ACCOUNT_1_PROXY_PASSWORD=

# ACCOUNT_2_EMAIL=second@example.com
# ACCOUNT_2_LABEL=Second account
