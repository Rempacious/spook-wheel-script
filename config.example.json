{
  "promoUrl": "https://www.coca-cola.com/ph/en/offerings/royal-halloween-2026/spook-the-wheel-promo",
  "timezone": "Asia/Manila",
  "sessionPath": "sessions",
  "headless": true,
  "browser": "chrome",
  "chromePath": "",
  "clusters": 1,
  "errorDiagnostics": false,
  "accountDelay": { "min": "1min", "max": "3min" },
  "globalTimeout": "30sec",

  "wheel": {
    "keepSpinningAfterWin": true,
    "maxSpinsPerAccount": 25,
    "accountTimeout": "10min",
    "stuckAfter": "2min",
    "loginCheckTimeout": "30sec",
    "pollInterval": "1500ms",
    "clickCooldown": "3sec",
    "resultDedupe": "5sec"
  },

  "schedule": {
    "enabled": false,
    "times": ["00:05", "12:00"],
    "runOnStart": false,
    "jitter": "2min"
  },

  "debugLogs": false,
  "consoleLogFilter": {
    "enabled": false,
    "mode": "whitelist",
    "levels": ["error", "warn"],
    "keywords": ["starting account"],
    "regexPatterns": []
  },

  "proxy": { "ignoreCertificateErrors": false },

  "webhook": {
    "maskIdentity": true,
    "mention": "",
    "discord": { "enabled": false, "url": "" },
    "telegram": { "enabled": false, "botToken": "", "chatId": "" },
    "ntfy": {
      "enabled": false,
      "url": "",
      "topic": "",
      "token": "",
      "title": "Spook-the-Wheel-Script",
      "tags": ["bot", "notify"],
      "priority": 3
    },
    "webhookLogFilter": {
      "enabled": true,
      "mode": "whitelist",
      "levels": ["error"],
      "keywords": ["won prize", "daily limit"],
      "regexPatterns": []
    }
  }
}
